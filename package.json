{
  "name": "@jimdo/history",
  "version": "4.9.0-beta.2.1",
  "description": "Manage session history with JavaScript",
  "repository": "@jimdo/history",
  "license": "MIT",
  "author": "Michael Jackson",
  "main": "index.js",
  "module": "esm/@jimdo/history.js",
  "unpkg": "umd/@jimdo/history.js",
  "files": [
    "DOMUtils.js",
    "ExecutionEnvironment.js",
    "LocationUtils.js",
    "PathUtils.js",
    "cjs",
    "createBrowserHistory.js",
    "createHashHistory.js",
    "createMemoryHistory.js",
    "createTransitionManager.js",
    "es",
    "esm",
    "umd",
    "warnAboutDeprecatedCJSRequire.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "clean": "git clean -fdX .",
    "lint": "eslint modules",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:build": "npm run build && TEST_ENV=cjs jest && TEST_ENV=umd jest"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.10",
    "loose-envify": "^1.2.0",
    "resolve-pathname": "^2.2.0",
    "tiny-invariant": "^1.0.2",
    "tiny-warning": "^1.0.0",
    "value-equal": "^0.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-object-assign": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "babel-jest": "^30.5.2",
    "babel-plugin-dev-expression": "^0.2.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "rollup": "^4.68.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "browserify": {
    "transform": [
      "loose-envify"
    ]
  },
  "keywords": [
    "history",
    "location"
  ],
  "volta": {
    "node": "24.21.0",
    "npm": "12.1.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  }
}
